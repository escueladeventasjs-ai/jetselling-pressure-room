body{
    margin:0;
    font-family:'Montserrat',sans-serif;
    background:#0A0E1A;
    color:white;
    overflow-x:hidden;
}

.bg-glow{
    position:fixed;
    width:900px;
    height:900px;
    background:radial-gradient(circle,#1B37FF55 0%,transparent 70%);
    top:-300px;
    right:-200px;
    z-index:-1;
}

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 40px;
    border-bottom:1px solid rgba(255,255,255,.08);
}

.brand{
    display:flex;
    align-items:center;
    gap:20px;
}

.logo-j{
    width:70px;
    height:70px;
    border-radius:20px;
    background:linear-gradient(135deg,#00FEF7,#1B37FF);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:42px;
    font-weight:900;
    color:#0A0E1A;
}

h1{
    margin:0;
    font-size:24px;
}

p{
    margin:5px 0 0;
    opacity:.7;
}

.mode-switch button,
.controls button{
    background:#1c2440;
    color:white;
    border:none;
    padding:12px 18px;
    border-radius:12px;
    cursor:pointer;
    font-weight:700;
}

.primary{
    background:linear-gradient(135deg,#00FEF7,#1B37FF)!important;
    color:#0A0E1A!important;
}

main{
    padding:30px;
}

.mode{
    display:none;
}

.mode.active{
    display:block;
}

.panel{
    background:#12182b;
    border:1px solid rgba(255,255,255,.08);
    border-radius:24px;
    padding:25px;
    box-shadow:0 0 40px rgba(27,55,255,.15);
}

.hero{
    margin-bottom:25px;
}

.dashboard{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:20px;
}

.card{
    margin-top:20px;
    padding:25px;
    border-radius:20px;
    min-height:120px;
    font-size:26px;
    font-weight:900;
    display:flex;
    align-items:center;
}

.blue{
    background:linear-gradient(135deg,#1B37FF,#212749);
}

.green{
    background:linear-gradient(135deg,#17DF96,#0d402d);
}

#timer{
    font-size:120px;
    font-weight:900;
    text-align:center;
    color:#00FEF7;
}

input{
    width:100%;
    margin-top:15px;
    padding:14px;
    border-radius:12px;
    border:none;
    background:#1b2340;
    color:white;
}

ul,ol{
    margin-top:20px;
}

li{
    padding:10px 0;
    border-bottom:1px solid rgba(255,255,255,.08);
}

@media(max-width:768px){

.topbar{
    flex-direction:column;
    gap:20px;
    text-align:center;
}

#timer{
    font-size:80px;
}

.card{
    font-size:22px;
}

}
